{
  "name": "HeistPrototype",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$path": "src/assets"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "Room": {
        "$path": "src/map/Room.model.json"
      },
      "Bank": {
        "$className": "Model",
        "$ignoreUnknownInstances": true,
        "Geometry": {
          "$path": "src/map/Bank.rbxm"
        },
        "Nodes": {
          "$path": "src/map/Bank.nodes.model.json"
        }
      },
      "Hub": {
        "$className": "Model",
        "$ignoreUnknownInstances": true,
        "Geometry": {
          "$path": "src/map/Hub.rbxm"
        },
        "Nodes": {
          "$path": "src/map/Hub.nodes.model.json"
        },
        "Dressing": {
          "$path": "src/map/Hub.dressing.rbxmx"
        }
      }
    }
  }
}
